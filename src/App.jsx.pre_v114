const THEME_PRESETS = {
  labrea: { label: 'Padrão Lábrea Tech', principal: '#1e2a4a', secundaria: '#2563eb', cards: '#ffffff', icones: '#2563eb', titulos: '#0f172a', fundo: '#f4f1ea' },
