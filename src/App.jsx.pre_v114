const DEFAULT_ROLE_LABELS = { admin: 'Administrador', gerente: 'Gerente', operador: 'Operador', consulta: 'Consulta' };
const VALID_EMPRESA_ROLES = new Set(['admin', 'gerente', 'operador', 'consulta', 'secretario', 'tesoureiro']);
function normalizeProfileRole(value, labels = {}) {
  const raw = String(value || '').trim();
  if (VALID_EMPRESA_ROLES.has(raw)) return raw;
  const lower = raw.toLowerCase();
  const found = Object.entries(labels || {}).find(([key, label]) => String(label || '').trim().toLowerCase() === lower && VALID_EMPRESA_ROLES.has(key));
  if (found) return found[0];
  const defaultFound = Object.entries(DEFAULT_ROLE_LABELS).find(([key, label]) => String(label || '').trim().toLowerCase() === lower && VALID_EMPRESA_ROLES.has(key));
  if (defaultFound) return defaultFound[0];
  return 'consulta';
}
